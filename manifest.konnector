{
  "version": "2.0.1",
  "name": "Darty",
  "type": "konnector",
  "language": "node",
  "icon": "icon.svg",
  "slug": "darty",
  "source": "git@github.com:florian-bellencontre/cozy-konnector-darty.git",
  "editor": "Cozy",
  "vendor_link": "https://www.darty.com",
  "categories": [
    "shopping"
  ],
  "fields": {},
  "time_interval": [
    0,
    24
  ],
  "data_types": [
    "bill"
  ],
  "permissions": {
    "bank operations": {
      "type": "io.cozy.bank.operations"
    },
    "bills": {
      "type": "io.cozy.bills"
    },
    "files": {
      "type": "io.cozy.files"
    },
    "accounts": {
      "type": "io.cozy.accounts"
    },
    "carbon_copy": {
      "type": "io.cozy.certified.carbon_copy"
    }
  },
  "developer": {
    "name": "Cozy Cloud",
    "url": "https://cozy.io"
  },
  "langs": [
    "fr",
    "en"
  ],
  "locales": {
    "fr": {
      "short_description": "Récupère vos factures darty",
      "long_description": "**Configuration**\n\nPour connecter votre compte, connectez-vous directement sur le site de Darty depuis l'application mobile Twake/Cozy. Vos identifiants sont ensuite mémorisés sur votre téléphone pour les synchronisations suivantes.\n\nUne fois connecté, votre Cozy se connectera régulièrement à votre compte Darty pour récupérer les\nnouveaux éléments et les historiser dans un dossier Darty dans Drive.\n\nSi vous déconnectez votre compte Darty, les informations déjà sauvegardées dans votre Cozy restent disponibles. Vous pouvez les supprimer manuellement par ailleurs.",
      "permissions": {
        "bank operations": {
          "description": "Utilisé pour relier les factures à des operations bancaires"
        },
        "bills": {
          "description": "Utilisé pour sauver les données des factures"
        },
        "files": {
          "description": "Utilisé pour sauvegarder les factures"
        },
        "accounts": {
          "description": "Utilisé pour récupérer les informations de votre compte"
        },
        "carbon_copy": {
          "description": "Utilisé pour certifier que vos fichiers sont copies conformes avec les documents d'origine"
        }
      }
    },
    "en": {
      "short_description": "Fetch your darty bills",
      "long_description": "**Configuration**\nTo connect your account, log in directly on the Darty website from the Twake/Cozy mobile app. Your credentials are then stored on your phone for subsequent synchronisations.\n\nOnce logged in, your Cozy will automatically connect to your Darty account to retrieve new items and\nstore them in a Darty folder in Drive.\n\nIf you disconnect your Darty account, the information already saved in your Cozy remains available. You can delete them manually elsewhere.",
      "permissions": {
        "bank operations": {
          "description": "Required to link bank operations to bills"
        },
        "bills": {
          "description": "Required to save the bills data"
        },
        "files": {
          "description": "Required to save the file documents"
        },
        "accounts": {
          "description": "Required to get the account's data"
        },
        "carbon_copy": {
          "description": "Required for carbon copy documents"
        }
      }
    }
  },
  "banksTransactionRegExp": "\\bdarty\\b",
  "manifest_version": "2",
  "clientSide": true,
  "folders": [
    {
      "defaultDir": "$administrative/$konnector/$account"
    }
  ],
  "features": [
    "METADATA_DEDUP",
    "CARBON_COPY",
    "DOC_QUALIFICATION_V2"
  ],
  "qualification_labels": [
    "appliance_invoice"
  ]
}
